<!-- Search loads its component and index only when requested. -->
<ninja-keys hideBreadcrumbs noAutoLoadMdIcons placeholder="Type to start searching"></ninja-keys>
<script>
  let searchLoading;
  async function openSearchModal() {
    const ninjaKeys = document.querySelector('ninja-keys');
    const button = document.getElementById('search-toggle');
    if (!ninjaKeys) return;
    try {
      if (!searchLoading) {
        searchLoading = (async () => {
          await import("{{ '/assets/js/search/ninja-keys.min.js' | relative_url | bust_file_cache }}");
          await customElements.whenDefined('ninja-keys');
          await new Promise((resolve, reject) => {
            const script = document.createElement('script');
            script.src = "{{ '/assets/js/search-data.js' | relative_url }}?v={{ site.time | date: '%s' }}";
            script.onload = resolve;
            script.onerror = () => {
              script.remove();
              reject(new Error('Search index could not load'));
            };
            document.body.append(script);
          });
        })().catch((error) => {
          searchLoading = undefined;
          throw error;
        });
      }
      await searchLoading;
      ninjaKeys.classList.toggle('dark', document.documentElement.dataset.theme === 'dark');
      await ninjaKeys.updateComplete;
      ninjaKeys.open();
      if (button) button.textContent = 'Search';
    } catch (error) {
      if (button) button.textContent = 'Retry search';
    }
  }
  document.getElementById('search-toggle')?.removeAttribute('hidden');
  document.addEventListener('keydown', (event) => {
    const active = document.activeElement;
    const editing = active && (active.matches('input, textarea, select') || active.isContentEditable || active.tagName === 'NINJA-KEYS');
    if (!editing && (((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') || event.key === '/')) {
      event.preventDefault();
      openSearchModal();
    }
  });
</script>
