{% if site.posts.size > 0 %}
  <ul class="recent-list">
    {% for item in site.posts limit: page.latest_posts.limit %}
      <li>
        <time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %d, %Y' }}</time>
        <a href="{% if item.redirect %}{{ item.redirect | relative_url }}{% else %}{{ item.url | relative_url }}{% endif %}">{{ item.title }}</a>
      </li>
    {% endfor %}
  </ul>
{% else %}
  <p class="empty-state">No posts yet.</p>
{% endif %}
