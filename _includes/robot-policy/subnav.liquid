{% assign rp_models = site.robot_policies | sort: 'order' %}
<div class="rp-subnav">
  <div class="rp-subnav-inner">
    <nav class="rp-models" aria-label="Policies">
      {% for m in rp_models %}
        <a
          href="{{ m.url | relative_url }}"
          {% if m.url == page.url %}
            aria-current="page"
          {% endif %}
        >
          {{- m.model_name -}}
        </a>
      {% endfor %}
    </nav>
    {% if include.tabs %}
      <div class="rp-tabs" role="tablist" aria-label="Sections">
        <button type="button" role="tab" id="tab-inference" aria-controls="inference" aria-selected="true">Inference</button>
        <button type="button" role="tab" id="tab-training" aria-controls="training" aria-selected="false">Training</button>
        <button type="button" role="tab" id="tab-results" aria-controls="results" aria-selected="false">Results</button>
      </div>
    {% endif %}
  </div>
</div>
