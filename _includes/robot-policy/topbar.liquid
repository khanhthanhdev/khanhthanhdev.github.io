{% assign rp_models = site.robot_policies | sort: 'order' %}
<header class="rp-top">
  <nav class="rp-crumbs" aria-label="Breadcrumb">
    <a href="{{ '/' | relative_url }}">
      {{- site.first_name }}
      {{ site.last_name -}}
    </a>
    <span aria-hidden="true">/</span>
    <a href="{{ '/works/' | relative_url }}">works</a>
    <span aria-hidden="true">/</span>
    {% if include.model %}
      <a href="{{ '/works/robot-policy/' | relative_url }}">robot-policy</a>
      <span aria-hidden="true">/</span>
      <strong>{{ include.model }}</strong>
    {% else %}
      <strong>robot-policy</strong>
    {% endif %}
  </nav>
  <nav class="rp-models" aria-label="Policies">
    {% for m in rp_models %}
      <a
        href="{{ m.url | relative_url }}"
        {% if m.url == page.url %}
          aria-current="page"
        {% endif %}
      >
        {{- m.model_name -}}
      </a>
    {% endfor %}
  </nav>
  {% if include.tabs %}
    <div class="rp-tabs" role="tablist" aria-label="Sections">
      <button type="button" role="tab" id="tab-inference" aria-controls="inference" aria-selected="true">Inference</button>
      <button type="button" role="tab" id="tab-training" aria-controls="training" aria-selected="false">Training</button>
      <button type="button" role="tab" id="tab-results" aria-controls="results" aria-selected="false">Results</button>
    </div>
  {% endif %}
  <button type="button" class="rp-theme" id="rp-theme" aria-label="Change theme" title="Theme: light, dark or system">light</button>
</header>
