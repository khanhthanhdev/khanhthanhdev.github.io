{% comment %}
  One stepped explorer: the diagram on the left, the explanation, formulas and (for inference) the 3D stage on the right.
  Params: name (inference | training), steps (list from front matter), svg (include path), stage (true to add the 3D view).
{% endcomment %}
{% assign rp_steps = include.steps %}
{% assign first = rp_steps | first %}
{% comment %} The track is as tall as the steps need; the explorer sticks inside it and page scroll picks the step. {% endcomment %}
<div class="rp-scroll" style="--rp-steps: {{ rp_steps | size }}">
  <div class="rp-explorer{% if include.stage %} has-stage{% endif %}" data-explorer="{{ include.name }}">
    <div class="rp-split">
      <div class="rp-diagram">
        {% include {{ include.svg }} %}
        <div class="rp-diagram-tools">
          <button type="button" data-role="fit" title="Show the whole diagram">Fit</button>
        </div>
      </div>
      <div
        class="rp-splitter"
        role="separator"
        aria-orientation="vertical"
        aria-label="Resize the diagram and the explanation"
        tabindex="0"
      ></div>
      <div class="rp-side">
        {% if include.stage %}
          <div class="rp-stage" id="rp-stage">
            <div class="rp-stage-fallback" id="rp-stage-fallback">
              <strong>NexArm 3D view</strong>
              <span>Loading the robot model…</span>
            </div>
            <div class="rp-stage-tools">
              <button type="button" id="rp-motion" aria-pressed="false">Pause motion</button>
            </div>
          </div>
        {% endif %}
        <div class="rp-step-card" aria-live="polite">
          <div class="rp-step-count">Step 1 of {{ rp_steps | size }}</div>
          <h2>{{ first.title }}</h2>
          <div class="rp-step-body">{{ first.body | markdownify }}</div>
        </div>
        <div class="rp-controls">
          <nav class="rp-pager" aria-label="Steps">
            <button type="button" data-role="prev" aria-label="Previous step">‹</button>
            <ol class="rp-pages">
              {% for step in rp_steps %}
                <li>
                  <button
                    type="button"
                    data-index="{{ forloop.index0 }}"
                    aria-label="Step {{ forloop.index }}: {{ step.title | escape }}"
                    {% if forloop.first %}
                      aria-current="step"
                    {% endif %}
                  >
                    {{ forloop.index }}
                  </button>
                </li>
              {% endfor %}
            </ol>
            <button type="button" data-role="next" aria-label="Next step">›</button>
          </nav>
          <div class="rp-kbd-hint">scroll or <kbd>←</kbd> <kbd>→</kbd></div>
          <div class="rp-progress" aria-hidden="true"><span></span></div>
        </div>
      </div>
    </div>

    <ol class="rp-step-list">
      {% for step in rp_steps %}
        <li
          data-id="{{ step.id }}"
          data-bounds="{{ step.bounds | join: ' ' }}"
          data-stage="{{ step.stage | jsonify | escape }}"
        >
          <h3>{{ step.title }}</h3>
          <div class="rp-step-body">{{ step.body | markdownify }}</div>
          {% if step.formulas %}
            <div class="rp-formulas">
              {% for f in step.formulas %}
                <div class="rp-tex">{{ f | escape }}</div>
              {% endfor %}
            </div>
          {% endif %}
          {% if step.where %}
            <div class="rp-where">{{ step.where | markdownify }}</div>
          {% endif %}
          {% if step.shapes %}
            <div class="rp-step-shapes">{{ step.shapes }}</div>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  </div>
</div>
