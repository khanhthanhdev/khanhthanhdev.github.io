<!-- Metadata, OpenGraph and Schema.org -->
{% include metadata.liquid %}

<!-- Security: Content Security Policy -->
<!-- Permissive CSP suitable for academic websites. Allows external images, videos, and common embed services. -->
<!-- To customize for your needs, see: https://developer.mozilla.org/en-US/docs/Web/HTTP/CSP -->
<meta
  http-equiv="Content-Security-Policy"
  content="default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:; media-src 'self' https:; frame-src 'self' https:; connect-src 'self' https:;"
>

<!-- Resource Hints -->
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="dns-prefetch" href="https://cdn.jsdelivr.net">

<!-- Critical stylesheets download at high priority without blocking first paint. -->
<link rel="preload" href="{{ '/assets/css/bootstrap.min.css' | relative_url | bust_file_cache }}" as="style">
<link
  rel="stylesheet"
  href="{{ '/assets/css/bootstrap.min.css' | relative_url | bust_file_cache }}"
  media="print"
  onload="this.media='all'"
>
<noscript>
  <link rel="stylesheet" href="{{ '/assets/css/bootstrap.min.css' | relative_url | bust_file_cache }}">
</noscript>
<link rel="preload" href="{{ '/assets/css/mdb.min.css' | relative_url | bust_file_cache }}" as="style">
<link
  rel="stylesheet"
  href="{{ '/assets/css/mdb.min.css' | relative_url | bust_file_cache }}"
  media="print"
  onload="this.media='all'"
>
<noscript>
  <link rel="stylesheet" href="{{ '/assets/css/mdb.min.css' | relative_url | bust_file_cache }}">
</noscript>

{% if page.pretty_table %}
  <!-- Bootstrap Table -->
  <link
    rel="stylesheet"
    href="{{ site.third_party_libraries.bootstrap-table.url.css }}"
    integrity="{{ site.third_party_libraries.bootstrap-table.integrity.css }}"
    crossorigin="anonymous"
    media="print"
    onload="this.media='all'"
  >
{% endif %}

<!-- Fonts & Icons -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="{{ '/assets/css/academicons.min.css' | relative_url | bust_file_cache }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ '/assets/css/scholar-icons.css' | relative_url | bust_file_cache }}" media="print" onload="this.media='all'">
<link
  rel="stylesheet"
  type="text/css"
  href="{{ site.third_party_libraries.google_fonts.url.fonts }}"
  media="print"
  onload="this.media='all'"
>

<!-- Code Syntax Highlighting -->
<link
  rel="stylesheet"
  href="{{ '/assets/css/jekyll-pygments-themes-github.css' | relative_url | bust_file_cache }}"
  media="print"
  onload="this.media='all'"
  id="highlight_theme_light"
>

{% if page.toc and page.toc.sidebar %}
  <!-- Sidebar Table of Contents -->
  <link href="{{ '/assets/css/bootstrap-toc.min.css' | relative_url | bust_file_cache }}" rel="stylesheet" media="print" onload="this.media='all'">
{% endif %}

<!-- Styles -->

{% if page.pseudocode %}
  <!-- pseudocode -->
  <link
    rel="stylesheet"
    href="{{ site.third_party_libraries.pseudocode.url.css }}"
    integrity="{{ site.third_party_libraries.pseudocode.integrity.css }}"
    crossorigin="anonymous"
    media="print"
    onload="this.media='all'"
  >
{% endif %}

{% if site.icon.size <= 4 %}
  <link
    rel="shortcut icon"
    href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ site.icon }}</text></svg>"
  >
{% elsif site.icon != blank %}
  <link rel="shortcut icon" href="{{ site.icon | prepend: '/assets/img/' | relative_url | bust_file_cache}}">
{% endif %}
<link rel="preload" href="{{ '/assets/css/main.css' | relative_url | bust_css_cache }}" as="style">
<link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url | bust_css_cache }}" media="print" onload="this.media='all'">
<noscript>
  <link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url | bust_css_cache }}">
</noscript>
<link rel="stylesheet" href="{{ '/assets/css/icons.css' | relative_url | bust_css_cache }}" media="print" onload="this.media='all'">
<noscript>
  <link rel="stylesheet" href="{{ '/assets/css/icons.css' | relative_url | bust_css_cache }}">
</noscript>
{% if page.css %}
  {% for stylesheet in page.css %}
    <link rel="stylesheet" href="{{ stylesheet | relative_url | bust_file_cache }}">
  {% endfor %}
{% endif %}
<link rel="canonical" href="{{ page.url | replace:'index.html','' | absolute_url }}">

{% if site.enable_darkmode %}
  <!-- Dark Mode -->
  <script>
    // Tiny script to set theme immediately to prevent FOUC
    (function () {
      var themeSetting = localStorage.getItem('theme') || 'light';
      var computedTheme = themeSetting;
      if (themeSetting === 'system') {
        computedTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      document.documentElement.setAttribute('data-theme-setting', themeSetting);
      document.documentElement.setAttribute('data-theme', computedTheme);
    })();
  </script>
  <script defer src="{{ '/assets/js/theme.js' | relative_url | bust_file_cache }}"></script>
  <link
    rel="stylesheet"
    href="{{ '/assets/css/jekyll-pygments-themes-native.css' | relative_url | bust_file_cache }}"
    media="none"
    id="highlight_theme_dark"
  >
{% endif %}

{% if page.map %}
  <!-- GeoJSON support via Leaflet -->
  <link
    rel="stylesheet"
    href="{{ site.third_party_libraries.leaflet.url.css }}"
    integrity="{{ site.third_party_libraries.leaflet.integrity.css }}"
    crossorigin="anonymous"
    media="print"
    onload="this.media='all'"
  >
{% endif %}

{% if page.code_diff %}
  <!-- diff2html -->
  <link
    rel="stylesheet"
    href="{{ site.third_party_libraries.highlightjs.url.css.light }}"
    integrity="{{ site.third_party_libraries.highlightjs.integrity.css.light }}"
    crossorigin="anonymous"
    media="print"
    onload="this.media='screen and (prefers-color-scheme: light)'"
  >
  <link
    rel="stylesheet"
    href="{{ site.third_party_libraries.highlightjs.url.css.dark }}"
    integrity="{{ site.third_party_libraries.highlightjs.integrity.css.dark }}"
    crossorigin="anonymous"
    media="print"
    onload="this.media='screen and (prefers-color-scheme: dark)'"
  >
  <link
    rel="stylesheet"
    href="{{ site.third_party_libraries.diff2html.url.css }}"
    integrity="{{ site.third_party_libraries.diff2html.integrity.css }}"
    crossorigin="anonymous"
    media="print"
    onload="this.media='all'"
  >
{% endif %}

{% if page.images %}
  {% if page.images.compare %}
    <!-- Image comparison slider -->
    <link
      rel="stylesheet"
      href="{{ site.third_party_libraries.img-comparison-slider.url.css }}"
      integrity="{{ site.third_party_libraries.img-comparison-slider.integrity.css }}"
      crossorigin="anonymous"
      media="print"
      onload="this.media='all'"
    >
  {% endif %}
  {% if page.images.lightbox2 %}
    <!-- Lightbox2 -->
    <link
      rel="stylesheet"
      href="{{ site.third_party_libraries.lightbox2.url.css }}"
      integrity="{{ site.third_party_libraries.lightbox2.integrity.css }}"
      crossorigin="anonymous"
      media="print"
      onload="this.media='all'"
    >
  {% endif %}
  {% if page.images.photoswipe %}
    <!-- Photoswipe -->
    <link
      rel="stylesheet"
      href="{{ site.third_party_libraries.photoswipe.url.css }}"
      crossorigin="anonymous"
      media="print"
      onload="this.media='all'"
    >
  {% endif %}
  {% if page.images.slider %}
    <!-- Image slider -->
    <link
      rel="stylesheet"
      href="{{ site.third_party_libraries.swiper.url.css }}"
      integrity="{{ site.third_party_libraries.swiper.integrity.css }}"
      crossorigin="anonymous"
      media="print"
      onload="this.media='all'"
    >
  {% endif %}
  {% if page.images.spotlight %}
    <!-- Spotlight -->
    <link
      rel="stylesheet"
      href="{{ site.third_party_libraries.spotlight.url.css }}"
      integrity="{{ site.third_party_libraries.spotlight.integrity.css }}"
      crossorigin="anonymous"
      media="print"
      onload="this.media='all'"
    >
  {% endif %}
  {% if page.images.venobox %}
    <!-- Venobox -->
    <link
      rel="stylesheet"
      href="{{ site.third_party_libraries.venobox.url.css }}"
      integrity="{{ site.third_party_libraries.venobox.integrity.css }}"
      crossorigin="anonymous"
      media="print"
      onload="this.media='all'"
    >
  {% endif %}
{% endif %}

{% if page.tikzjax %}
  <link
    rel="stylesheet"
    type="text/css"
    href="{{ '/assets/css/tikzjax.min.css' | relative_url | bust_file_cache }}"
    media="print"
    onload="this.media='all'"
  >
{% endif %}

{% if site.enable_cookie_consent %}
  <!-- Cookie Consent -->
  <link
    rel="stylesheet"
    href="{{ site.third_party_libraries.vanilla-cookieconsent.url.css }}"
    integrity="{{ site.third_party_libraries.vanilla-cookieconsent.integrity.css }}"
    crossorigin="anonymous"
    media="print"
    onload="this.media='all'"
  >
{% endif %}

<!-- GoatCounter Analytics -->
<script
  data-goatcounter="https://khanhthanhdev.goatcounter.com/count"
  async
  src="//gc.zgo.at/count.js"
></script>
