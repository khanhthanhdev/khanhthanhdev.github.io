{% comment %}
  Navigation for the "Deep learning for computer vision" series. Parts that are not published yet are listed without a link.
  Usage: {% include cv-series.liquid %} in a post with `series: deep-learning-for-computer-vision` and `part: N`.
{% endcomment %}
{% assign cv_titles = 'Image classification and nearest neighbours|Linear classifiers and loss functions|Optimisation|Backpropagation and neural networks|Convolutional networks|Visualising and understanding|CNN architectures|Detection and segmentation|Vision transformers'
  | split: '|'
%}
{% assign cv_parts = site.posts | where: 'series', 'deep-learning-for-computer-vision' %}
<nav class="tf-series" aria-label="Series: Deep learning for computer vision">
  <span class="tf-label">Series · Deep learning for computer vision</span>
  {% for title in cv_titles %}
    {% assign n = forloop.index %}
    {% assign cv_post = cv_parts | where: 'part', n | first %}
    {% if cv_post == null %}
      <span
        ><b>{{ n }}</b>{{ title }} · soon</span
      >
    {% elsif cv_post.url == page.url %}
      <span aria-current="page"
        ><b>{{ n }}</b>{{ title -}}
      </span>
    {% else %}
      <a href="{{ cv_post.url | relative_url }}"
        ><b>{{ n }}</b>{{ title -}}
      </a>
    {% endif %}
  {% endfor %}
</nav>
