<header class="site-header">
  <nav class="site-nav container" aria-label="Main navigation">
    <a class="site-name" href="{{ '/' | relative_url }}">
      {{- site.first_name }}
      {{ site.middle_name }}
      {{ site.last_name -}}
    </a>
    <div class="site-nav-links">
      <a
        href="{{ '/' | relative_url }}"
        {% if page.permalink == '/' %}
          aria-current="page"
        {% endif %}
        >Home</a
      >
      <a
        href="{{ '/works/' | relative_url }}"
        {% if page.url contains '/works/' or page.url contains '/projects/' %}
          aria-current="page"
        {% endif %}
        >Works</a
      >
      <a
        href="{{ '/blog/' | relative_url }}"
        {% if page.url contains '/blog/' %}
          aria-current="page"
        {% endif %}
        >Blog</a
      >
      <a
        href="{{ '/cv/' | relative_url }}"
        {% if page.url contains '/cv/' %}
          aria-current="page"
        {% endif %}
        >CV</a
      >
      {% if site.search_enabled -%}
        <button type="button" id="search-toggle" onclick="openSearchModal()" hidden>Search</button>
      {%- endif %}
      {% if site.enable_darkmode -%}
        <button type="button" id="light-toggle" aria-label="Change color theme" hidden>Theme</button>
      {%- endif %}
    </div>
  </nav>
</header>
