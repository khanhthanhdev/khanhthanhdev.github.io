{% assign latest_projects = site.projects | sort: 'date' | reverse %}
{% if latest_projects.size > 0 %}
  <ul class="recent-list">
    {% for item in latest_projects limit: page.latest_projects.limit %}
      <li>
        <time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%Y' }}</time>
        <div>
          <a href="{% if item.redirect %}{{ item.redirect | relative_url }}{% else %}{{ item.url | relative_url }}{% endif %}">{{ item.title }}</a>
          {% if item.description %}
            <p>{{ item.description }}</p>
          {% endif %}
        </div>
      </li>
    {% endfor %}
  </ul>
{% else %}
  <p class="empty-state">No projects yet.</p>
{% endif %}
