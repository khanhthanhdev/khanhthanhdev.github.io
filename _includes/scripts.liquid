{% assign mermaid_enabled = false %}
{% if page.mermaid and page.mermaid.enabled != false %}
  {% assign mermaid_enabled = true %}
{% endif %}
{% if mermaid_enabled %}
  <!-- Mermaid and D3 -->
  <script
    defer
    src="{{ site.third_party_libraries.mermaid.url.js }}"
    integrity="{{ site.third_party_libraries.mermaid.integrity.js }}"
    crossorigin="anonymous"
  ></script>
  <script
    defer
    src="{{ site.third_party_libraries.d3.url.js }}"
    integrity="{{ site.third_party_libraries.d3.integrity.js }}"
    crossorigin="anonymous"
  ></script>
  <script defer src="{{ '/assets/js/mermaid-setup.js' | relative_url | bust_file_cache }}" type="text/javascript"></script>
{% endif %}

{% if site.enable_medium_zoom and content contains 'data-zoomable' %}
  <!-- Medium Zoom JS -->
  <script
    defer
    src="{{ site.third_party_libraries.medium_zoom.url.js }}"
    integrity="{{ site.third_party_libraries.medium_zoom.integrity.js }}"
    crossorigin="anonymous"
  ></script>
  <script defer src="{{ '/assets/js/zoom.js' | relative_url | bust_file_cache }}"></script>
{% endif %}

{% if page.toc and page.toc.sidebar %}
  <!-- Sidebar Table of Contents -->
  <script type="module" src="{{ '/assets/js/toc.mjs' | relative_url | bust_file_cache }}"></script>
{% endif %}

<!-- Badges -->
{% if site.enable_publication_badges.altmetric and (page.selected_papers or page.publications or page.layout == 'about' or page.layout == 'publications') %}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      if (document.querySelector('.altmetric-embed')) {
        var script = document.createElement('script');
        script.src = 'https://embed.altmetric.com/assets/embed.js';
        script.defer = true;
        document.body.appendChild(script);
      }
    });
  </script>
{% endif %}
{% if site.enable_publication_badges.dimensions and (page.selected_papers or page.publications or page.layout == 'about' or page.layout == 'publications') %}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      if (document.querySelector('.__dimensions_badge_embed__')) {
        var script = document.createElement('script');
        script.src = 'https://badge.dimensions.ai/badge.js';
        script.async = true;
        document.body.appendChild(script);
      }
    });
  </script>
{% endif %}

{% if site.enable_math and (page.enable_math or page.math) %}
  <script defer src="{{ '/assets/js/mathjax-setup.js' | relative_url | bust_file_cache }}"></script>
  <script
    defer
    id="MathJax-script"
    src="{{ site.third_party_libraries.mathjax.url.js }}"
    integrity="{{ site.third_party_libraries.mathjax.integrity.js }}"
    crossorigin="anonymous"
  ></script>
{% endif %}
{% if content contains '<code' %}
  <script defer src="{{ '/assets/js/copy_code.js' | relative_url | bust_file_cache }}"></script>
{% endif %}
{% if site.search_enabled %}{% include search.liquid %}{% endif %}
{% if page.life_divider %}
  <script type="module" src="{{ '/assets/js/life-divider.mjs' | relative_url | bust_file_cache }}"></script>
{% endif %}
{% if page.sidenotes and page.toc.sidebar == null %}
  <script type="module" src="{{ '/assets/js/sidenotes.mjs' | relative_url | bust_file_cache }}"></script>
{% endif %}
{% if page.js %}
  {% for script in page.js %}
    <script defer src="{{ script | relative_url | bust_file_cache }}"></script>
  {% endfor %}
{% endif %}
