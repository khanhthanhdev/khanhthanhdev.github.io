<!doctype html>
<html lang="{{ site.lang }}">
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
  </head>

  <!-- Body -->
  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <div class="container mt-5" role="main">
      {% if page.toc and page.toc.sidebar %}
        {% capture toc_sidebar_col %}
          <div class="col-lg-3 col-xl-2">
            <aside id="toc-sidebar" class="toc-sidebar">
              <div class="toc-sidebar-header">
                <span class="toc-title">Table of Contents</span>
                <button id="close-sidebar-btn" class="toc-close-btn" aria-label="Collapse TOC">
                  <i class="fa-solid fa-angle-down"></i>
                </button>
              </div>
              <nav id="toc-sidebar-nav" class="toc-nav"></nav>
            </aside>
            <button id="open-sidebar-btn" class="toc-open-btn" aria-label="Open TOC" style="display: none;">
              <i class="fa-solid fa-list"></i> Table of Contents
            </button>
          </div>
        {% endcapture %}
        {% capture toc_main_col %}
          <div class="col-lg-9 col-xl-10">{{ content }}</div>
        {% endcapture %}
        <div class="row toc-sidebar-container">
          {% if page.toc.sidebar == 'right' %}
            {{ toc_main_col }}
            {{ toc_sidebar_col }}
          {% else %}
            {{ toc_sidebar_col }}
            {{ toc_main_col }}
          {% endif %}
        </div>
      {% else %}
        {{ content }}
      {% endif %}
    </div>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include scripts.liquid %}
  </body>
</html>
